* text=auto
# Scripts and configs run inside Linux containers: they must keep LF endings,
# or LocalStack init scripts fail with "/bin/bash^M: bad interpreter".
*.sh      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.conf    text eol=lf
*.cfg     text eol=lf
*.html    text eol=lf
*.py      text eol=lf
*.md      text eol=lf
Dockerfile text eol=lf
*.docx    binary
*.pdf     binary
